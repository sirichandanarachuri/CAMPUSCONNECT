# Copy this file to .env for local development. Do not commit .env.
# Set production values in Render's Environment settings instead.

# Required in every environment. Use a long, random value in production.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Render/PostgreSQL: set this to Render's internal PostgreSQL connection URL.
# Leave it empty locally to use the MySQL settings below.
DATABASE_URL=
DB_CONN_MAX_AGE=600

# Local MySQL fallback, used only when DATABASE_URL is not set.
DB_NAME=campusconnect_db
DB_USER=campusconnect_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: defaults to SECRET_KEY when omitted.
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret

# Comma-separated, exact browser origins that may call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

